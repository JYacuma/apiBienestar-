<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_registro"
    app:startDestination="@id/seleccionRolFragment">

    <fragment
        android:id="@+id/seleccionRolFragment"
        android:name="com.example.bienestar.ui.autenticacion.SeleccionRolFragment"
        android:label="SeleccionRolFragment"
        tools:layout="@layout/fragment_seleccion_rol">
        <action
            android:id="@+id/action_seleccion_to_estudiante"
            app:destination="@id/registroEstudianteFragment" />
        <action
            android:id="@+id/action_seleccion_to_profesional"
            app:destination="@id/registroProfesionalFragment" />
    </fragment>

    <fragment
        android:id="@+id/registroEstudianteFragment"
        android:name="com.example.bienestar.ui.autenticacion.RegistroEstudianteFragment"
        android:label="RegistroEstudianteFragment"
        tools:layout="@layout/fragment_registro_estudiante">
        <action
            android:id="@+id/action_global_login"
            app:popUpTo="@id/nav_registro"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registroProfesionalFragment"
        android:name="com.example.bienestar.ui.autenticacion.RegistroProfesionalFragment"
        android:label="RegistroProfesionalFragment"
        tools:layout="@layout/fragment_registro_profesional">
        <action
            android:id="@+id/action_global_login"
            app:popUpTo="@id/nav_registro"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>